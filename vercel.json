{
  "functions": {
    "api/gemini.js": {
      "maxDuration": 60
    },
    "api/health.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 2,10,18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
