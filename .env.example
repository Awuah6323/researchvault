# ResearchVault environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# IMPORTANT — the VITE_ prefix makes a value PUBLIC.
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle it
# ships to the browser, so anyone loading the site can read it. Only put
# values here that are safe to publish. Secrets must be un-prefixed, which
# keeps them server-side, readable only by the functions in /api.


# ---------------------------------------------------------------- REQUIRED
# Supabase — auth and cross-device sync.
#
# Dashboard -> Project Settings -> API. Copy "Project URL" and the "anon public"
# key. Both are PUBLIC by design and ship in the browser bundle: the anon key
# identifies the project, not a person, and grants nothing on its own because
# every table is behind the Row Level Security policies in supabase/schema.sql.
#
# NEVER put the service_role key in here or anywhere in this app. It bypasses
# RLS entirely, and with the VITE_ prefix it would be published to every visitor.
#
# Without these two the app still runs: localStorage works, the library works,
# and the sync badge says "This device only". Nothing is lost, but no data
# reaches your other devices.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# Server-side Gemini key, read only by /api/gemini.
# Never give this the VITE_ prefix: an earlier version of this file suggested
# a VITE_GEMINI_API_KEY, which published the key in the client bundle.
GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY


# ---------------------------------------------------------------- OPTIONAL
# Google sign-in needs no variable here. It is configured inside Supabase
# (Authentication -> Providers -> Google), which holds the client secret
# server-side. That is why VITE_GOOGLE_CLIENT_ID is no longer used.


# ---------------------------------------------------------------- LOCAL DEV
# `npm run dev` is enough for auth and sync — the client talks to Supabase
# directly, so no serverless functions are involved.
#
# The only route still needing `npx vercel dev` is /api/gemini, because the
# Gemini key must stay server-side. Without it the AI features fall back to
# their scripted engine.
