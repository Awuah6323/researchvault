# ResearchVault environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# IMPORTANT — the VITE_ prefix makes a value PUBLIC.
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle it
# ships to the browser, so anyone loading the site can read it. Only put
# values here that are safe to publish. Secrets must be un-prefixed, which
# keeps them server-side, readable only by the functions in /api.


# ---------------------------------------------------------------- REQUIRED
# Cross-device sync storage (Upstash Redis, accessed over its REST API).
#
# Easiest path: in your Vercel project go to Storage -> Upstash Redis and add
# the integration. It injects both of these for you and you can leave this
# section alone.
#
# Without them the backend falls back to a per-instance in-memory store: the
# app still works, but data lives only on the device that created it and the
# sync badge reads "This device only". Nothing is lost — localStorage is the
# source of truth either way — but no data reaches your other devices.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN
# KV_REST_API_URL / KV_REST_API_TOKEN are accepted as aliases, for projects
# still using Vercel's older KV integration.


# Server-side Gemini key, read only by /api/gemini.
# Never give this the VITE_ prefix: an earlier version of this file suggested
# a VITE_GEMINI_API_KEY, which published the key in the client bundle.
GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY


# ---------------------------------------------------------------- RECOMMENDED
# Your deployed origin, e.g. https://researchvault.vercel.app
# The /api functions send this in Access-Control-Allow-Origin. Setting it
# means CORS names one specific origin instead of falling back to a wildcard.
PUBLIC_APP_ORIGIN=https://your-app.vercel.app


# Google OAuth 2.0 Web Client ID (Google Cloud Console -> Credentials).
#
# Needed twice, deliberately:
#   VITE_GOOGLE_CLIENT_ID  the browser passes it to Google Identity Services
#   GOOGLE_CLIENT_ID       /api/auth checks the `aud` claim of the returned
#                          token against it, so a token minted for some other
#                          app cannot be replayed here
#
# A client ID is not a secret — it is visible in any OAuth flow — so having
# the VITE_ copy in the bundle is fine. Set both to the same value.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com


# ---------------------------------------------------------------- LOCAL DEV
# `npm run dev` serves the frontend but does NOT execute /api functions, so
# sign-in falls into local-only mode. To exercise auth and sync locally:
#
#   npx vercel dev
