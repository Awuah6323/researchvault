
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


.
GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY


AI_DISABLED=false


# ---------------------------------------------------------------- OPTIONAL
# Google sign-in needs no variable here. It is configured inside Supabase
# (Authentication -> Providers -> Google), which holds the client secret
# server-side. That is why VITE_GOOGLE_CLIENT_ID is no longer used.


# --------------------------------------------------------- API HARDENING
# Everything below is read only by the functions in /api. None of it is
# VITE_-prefixed, so none of it reaches the browser.


# Browser origins allowed to call /api, comma separated. Requests from any
# other origin are refused with 403 — the API is never opened with a wildcard,
# because these endpoints carry bearer tokens.
#
# Vercel's own production and deployment URLs are allowed automatically, so
# this is only needed for a custom domain. Localhost is allowed automatically
# outside production, so local development needs nothing here.
#
# ALLOWED_ORIGINS=https://researchvault.example.com,https://www.researchvault.example.com


# Shared secret for the deep health check at /api/health.
#
# Without it, /api/health answers anonymous callers with liveness only ("the
# function is running") and never touches the database. With it, a caller
# sending `Authorization: Bearer <this value>` gets the full check including
# the database round trip. Vercel's own cron is recognised automatically and
# does not need the header.
#
# Generate one with:  openssl rand -hex 32
#
# CRON_SECRET=


# Distributed rate limiting (STRONGLY RECOMMENDED for production).
#
# Vercel runs each function in isolated instances that scale horizontally, so
# an in-memory counter is per-instance: a caller spreading requests across warm
# instances gets a multiple of the intended limit. A shared counter in Supabase
# Postgres makes one limit apply across all of them.
#
# Two steps:
#   1. Run supabase/schema.sql (it creates public.rate_limits and the
#      rv_rate_limit_hit / rv_rate_limit_gc functions).
#   2. Set SUPABASE_SERVICE_ROLE_KEY below.
#
# Without the key the app still runs and still rate limits — just per-instance.


# Server-side Supabase credentials for /api.
#
# SUPABASE_URL is optional: the functions fall back to the VITE_-prefixed URL
# above. SUPABASE_ANON_KEY is likewise optional and is what verifies callers'
# access tokens — deliberately the anon key, never the service_role one.
#
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key


# The service_role key bypasses Row Level Security completely, so it must NEVER
# be given the VITE_ prefix and must never appear in client code.
#
# One thing reads it: the rate limiter, which calls rv_rate_limit_hit. That
# function is `security definer` with EXECUTE revoked from anon and
# authenticated, because a counter the browser can increment is a counter one
# user could use to lock another out of the AI features. Token verification and
# /api/health both still prefer the anon key.
#
# SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------- LOCAL DEV
# `npm run dev` is enough for auth and sync — the client talks to Supabase
# directly, so no serverless functions are involved.
#
# The only route still needing `npx vercel dev` is /api/gemini, because the
# Gemini key must stay server-side. Without it the AI features fall back to
# their scripted engine.
#
# Note that /api/gemini requires a signed-in caller whenever Supabase is
# configured: the browser sends its Supabase access token, and the proxy
# verifies it before spending the Gemini key.
